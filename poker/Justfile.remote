# In-pod Justfile (copy to /workspace/Justfile inside the poker pod).
# Pattern from https://github.com/tlrmchlsmth/j-llm-d/blob/raj/ttft/Justfile.remote — substituted via envsubst for ${BASE_URL} and ${NAMESPACE}.
# Requires in the poker image: jq, curl, vllm. Optional: just (otherwise repo-root `just benchmark` bootstraps a Linux just binary into /tmp).
#
# BASE_URL must be the HTTP root of the gateway (no trailing /v1); recipes append /v1 where needed.

BASE_URL := "${BASE_URL}"
NAMESPACE := "${NAMESPACE}"

default:
  @just --list

# Detect model from the gateway OpenAI /v1/models (override with BENCHMARK_MODEL if discovery is unavailable).
# Do not use @ on this recipe: nested `$(just _model)` would echo the shebang script to the terminal (just + shebang quirk).
_model:
  #!/usr/bin/env bash
  if [[ -n "${BENCHMARK_MODEL:-}" ]]; then
    echo "$BENCHMARK_MODEL"
    exit 0
  fi
  if ! RESP=$(curl -sfS "{{BASE_URL}}/v1/models"); then
    echo "ERROR: GET {{BASE_URL}}/v1/models failed (e.g. HTTP 404). Attach routes to the Gateway, e.g.:" >&2
    echo "  kubectl apply -f guides/pd-disaggregation/httproute.yaml -n {{NAMESPACE}}" >&2
    echo "Or set BENCHMARK_MODEL to the served model id." >&2
    exit 1
  fi
  MODEL=$(echo "$RESP" | jq -r '.data[0].id' 2>/dev/null)
  if [[ -z "$MODEL" || "$MODEL" == "null" ]]; then
    echo "ERROR: No model in /v1/models (.data empty). Often the Gateway needs an HTTPRoute to the InferencePool." >&2
    echo "Response (truncated): ${RESP:0:500}" >&2
    exit 1
  fi
  echo "$MODEL"

# Same signature as j-llm-d: MC NUM_REQUESTS INPUT_LEN OUTPUT_LEN
benchmark MC NUM_REQUESTS INPUT_LEN OUTPUT_LEN:
  #!/usr/bin/env bash
  set -euo pipefail
  MODEL="$(just _model)"
  vllm bench serve \
    --base-url {{BASE_URL}} \
    --model "$MODEL" \
    --dataset-name random \
    --random-input-len {{INPUT_LEN}} \
    --random-output-len {{OUTPUT_LEN}} \
    --max-concurrency {{MC}} \
    --request-rate 4096 \
    --seed "$(date +%M%H%M%S)" \
    --num-prompts {{NUM_REQUESTS}} \
    --ignore-eos

# N waves of X concurrent requests (total prompts = N * X)
benchmark-a N X INPUT_LEN OUTPUT_LEN:
  #!/usr/bin/env bash
  set -euo pipefail
  N_X=$(( {{N}} * {{X}} ))
  outfile="${OUTFILE:-run_benchmark_{{N}}x{{X}}_$(date +%Y%m%d_%H%M%S).log}"
  just benchmark "{{X}}" "$N_X" "{{INPUT_LEN}}" "{{OUTPUT_LEN}}" 2>&1 | tee "$outfile"

# Pure decode-ish workload (input len 1)
benchmark_decode_workload NUM_REQUESTS OUTPUT_LEN:
  #!/usr/bin/env bash
  set -euo pipefail
  MODEL="$(just _model)"
  vllm bench serve \
    --base-url {{BASE_URL}} \
    --model "$MODEL" \
    --dataset-name random \
    --random-input-len 1 \
    --random-output-len {{OUTPUT_LEN}} \
    --seed "$(date +%M%H%M%S)" \
    --num-prompts {{NUM_REQUESTS}} \
    --ignore-eos

# Hit a single vLLM pod by IP (bypass gateway)
benchmark_no_pd POD_IP RR NUM_REQUESTS INPUT_LEN OUTPUT_LEN:
  vllm bench serve \
    --base-url http://{{POD_IP}}:8000 \
    --model $(curl -s http://{{POD_IP}}:8000/v1/models | jq -r '.data[0].id') \
    --dataset-name random \
    --random-input-len {{INPUT_LEN}} \
    --random-output-len {{OUTPUT_LEN}} \
    --request-rate {{RR}} \
    --seed $(date +%M%H%M%S) \
    --num-prompts {{NUM_REQUESTS}} \
    --ignore-eos

start_profile URL:
  curl -sS -X POST "{{URL}}/start_profile"
stop_profile URL:
  curl -sS -X POST "{{URL}}/stop_profile"
profile URL:
  just start_profile "{{URL}}" && sleep 1 && just stop_profile "{{URL}}"

profile_all_decode:
  #!/usr/bin/env bash
  set -euo pipefail
  echo "Detecting decode pods..."
  DECODE_IPS=$(kubectl get pods -n "{{NAMESPACE}}" -o json | jq -r '.items[] | select(.metadata.name | contains("decode")) | .status.podIP' | tr '\n' ' ')
  if [[ -z "$DECODE_IPS" ]]; then
    echo "No decode pods found in namespace {{NAMESPACE}}" >&2
    exit 1
  fi
  echo "Decode pod IPs: $DECODE_IPS"
  for IP in $DECODE_IPS; do
    curl -sS -X POST "http://${IP}:8200/start_profile" &
  done
  wait
  sleep 1
  for IP in $DECODE_IPS; do
    curl -sS -X POST "http://${IP}:8200/stop_profile" &
  done
  wait
  echo "Profiling complete on all decode pods."
