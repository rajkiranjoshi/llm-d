# P/D disaggregation + poker — run from this directory (or use `just -f … --working-directory …`).
# AKS: `helmfile apply -e aks` with optional PREFILL_TP, DECODE_TP, PREFILL_REPLICAS, DECODE_REPLICAS (see .env.example).
set dotenv-load

NAMESPACE := env("NAMESPACE", env("USER", "dev") + "-dev")
HF_TOKEN := env("HF_TOKEN", "")
KN := "kubectl -n " + NAMESPACE

default:
  @just --list
  @echo ""
  @echo "Tip: cd guides/pd-disaggregation (or use --working-directory). AKS: just start | just stop | just grafana"

# --- Namespace + secret (AKS uses hf-secret; see ms-pd/values_aks.yaml authSecretName) ---
setup:
  #!/usr/bin/env bash
  set -euo pipefail
  kubectl create ns "{{NAMESPACE}}" --dry-run=client -o yaml | kubectl apply -f -
  kubectl label --overwrite ns "{{NAMESPACE}}" pod-security.kubernetes.io/enforce=privileged
  kubectl create secret generic hf-secret \
    --from-literal=HF_TOKEN="{{HF_TOKEN}}" -n "{{NAMESPACE}}" \
    --dry-run=client -o yaml | kubectl apply -f -

# Helm only (no HTTPRoute). Uses llm-d-cuda image with in-tree NIC selection (no ConfigMap hotfix).
deploy-helm:
  #!/usr/bin/env bash
  set -euo pipefail
  PD_DIR="$(git rev-parse --show-toplevel)/guides/pd-disaggregation"
  cd "$PD_DIR"
  export AKS_UCX_HOTFIX=false
  export PREFILL_TP="${PREFILL_TP:-8}"
  export DECODE_TP="${DECODE_TP:-8}"
  export PREFILL_REPLICAS="${PREFILL_REPLICAS:-1}"
  export DECODE_REPLICAS="${DECODE_REPLICAS:-1}"
  helmfile -f helmfile.yaml.gotmpl apply -e aks -n "{{NAMESPACE}}"

# Helm only (no HTTPRoute). Uses RHAII image + ConfigMap UCX NIC-selection hotfix overlay.
deploy-hotfix-helm:
  #!/usr/bin/env bash
  set -euo pipefail
  PD_DIR="$(git rev-parse --show-toplevel)/guides/pd-disaggregation"
  cd "$PD_DIR"
  export AKS_UCX_HOTFIX=true
  export PREFILL_TP="${PREFILL_TP:-8}"
  export DECODE_TP="${DECODE_TP:-8}"
  export PREFILL_REPLICAS="${PREFILL_REPLICAS:-1}"
  export DECODE_REPLICAS="${DECODE_REPLICAS:-1}"
  helmfile -f helmfile.yaml.gotmpl apply -e aks -n "{{NAMESPACE}}"

apply-httproute:
  #!/usr/bin/env bash
  set -euo pipefail
  PD_DIR="$(git rev-parse --show-toplevel)/guides/pd-disaggregation"
  kubectl apply -f "$PD_DIR/httproute.yaml" -n "{{NAMESPACE}}"

# Helm + HTTPRoute (full stack routing, llm-d-cuda image).
deploy:
  just deploy-helm
  just apply-httproute

# Helm + HTTPRoute (RHAII image + ConfigMap hotfix).
deploy-hotfix:
  just deploy-hotfix-helm
  just apply-httproute

# Idempotent setup + deploy with explicit TP/replicas (safe first time and on retune).
deploy-with-tp PREFILL_TP DECODE_TP PREFILL_REPLICAS DECODE_REPLICAS:
  #!/usr/bin/env bash
  set -euo pipefail
  export PREFILL_TP="{{PREFILL_TP}}"
  export DECODE_TP="{{DECODE_TP}}"
  export PREFILL_REPLICAS="{{PREFILL_REPLICAS}}"
  export DECODE_REPLICAS="{{DECODE_REPLICAS}}"
  just setup
  just deploy

# One-shot: namespace secret + helm + route (llm-d-cuda image).
start:
  just setup
  just deploy

# One-shot: namespace secret + helm + route (RHAII image + ConfigMap hotfix).
start-hotfix:
  just setup
  just deploy-hotfix

# Teardown P/D only (helmfile + HTTPRoute). Does not remove poker — use `just stop-poker` separately.
stop:
  just destroy

destroy:
  #!/usr/bin/env bash
  set -euo pipefail
  PD_DIR="$(git rev-parse --show-toplevel)/guides/pd-disaggregation"
  cd "$PD_DIR"
  # AKS_UCX_HOTFIX=true so helmfile includes the hotfix chart in the destroy manifest (no-op if it wasn't installed).
  export AKS_UCX_HOTFIX=true
  helmfile -f helmfile.yaml.gotmpl destroy -e aks -n "{{NAMESPACE}}"
  kubectl delete -f "$PD_DIR/httproute.yaml" -n "{{NAMESPACE}}" --ignore-not-found=true

status:
  {{KN}} get pods -o wide
  @echo ""
  {{KN}} get inferencepool,inferencemodel 2>/dev/null || true

releases:
  helm list -n {{NAMESPACE}}

ready:
  #!/usr/bin/env bash
  set -euo pipefail
  # EPP pods use selector label inferencepool=<release>-epp (chart selectorLabels), not app.kubernetes.io/name (that is on the Deployment only).
  REL=$(printf 'gaie-%s' "${RELEASE_NAME_POSTFIX:-pd}" | tr '[:upper:]' '[:lower:]')
  EPP_POOL_NAME="${REL}-epp"
  # kubectl wait --for=condition=Ready fails immediately if zero pods match; poll until at least one exists.
  await_pods_then_ready() {
    local sel="$1"
    local appear_timeout="${2:-600}"
    local ready_timeout="${3:-1200}"
    local waited=0
    while true; do
      n=$( {{KN}} get pods -l "$sel" --no-headers 2>/dev/null | wc -l | tr -d ' ' )
      if [[ "${n:-0}" -ge 1 ]]; then
        break
      fi
      if [[ "$waited" -ge "$appear_timeout" ]]; then
        echo "timeout: no pods matched -l ${sel} within ${appear_timeout}s" >&2
        return 1
      fi
      sleep 2
      waited=$((waited + 2))
    done
    {{KN}} wait --for=condition=Ready pod -l "$sel" --timeout="${ready_timeout}s"
  }
  echo "Waiting for decode pods..."
  ( await_pods_then_ready "llm-d.ai/role=decode" 600 1200 ) &
  pid_decode=$!
  echo "Waiting for prefill pods..."
  ( await_pods_then_ready "llm-d.ai/role=prefill" 600 1200 ) &
  pid_prefill=$!
  echo "Waiting for EPP pod (inferencepool=${EPP_POOL_NAME})..."
  ( await_pods_then_ready "inferencepool=${EPP_POOL_NAME}" 600 1200 ) &
  pid_epp=$!
  fail=0
  wait "$pid_decode" || fail=1
  wait "$pid_prefill" || fail=1
  wait "$pid_epp" || fail=1
  if [[ "$fail" -ne 0 ]]; then
    echo "One or more readiness waits failed." >&2
    exit 1
  fi
  echo "All pods ready."

restart:
  #!/usr/bin/env bash
  set -euo pipefail
  {{KN}} delete pod -l llm-d.ai/role=decode --grace-period=0 --force --ignore-not-found=true &
  {{KN}} delete pod -l llm-d.ai/role=prefill --grace-period=0 --force --ignore-not-found=true &
  wait
  just deploy

logs ROLE='decode':
  {{KN}} logs -l llm-d.ai/role={{ROLE}} -c vllm --tail=100 -f --max-log-requests=10

# Port-forward Grafana (monitoring stack namespace; not the P/D NAMESPACE).
grafana:
  kubectl port-forward -n llm-d-monitoring svc/llmd-grafana 3000:80 > /dev/null 2>&1 &
  @echo "Grafana: http://localhost:3000 (default credentials are often admin/admin)"

# --- Poker (manifests live at repo root /poker) ---
start-poker:
  #!/usr/bin/env bash
  set -euo pipefail
  kubectl apply -f "$(git rev-parse --show-toplevel)/poker/poker.yaml" -n "{{NAMESPACE}}"

_sync-poker-justfile:
  #!/usr/bin/env bash
  set -euo pipefail
  GATEWAY_SVC=$(kubectl -n "{{NAMESPACE}}" get svc -l gateway.networking.k8s.io/gateway-name -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
  if [ -z "$GATEWAY_SVC" ]; then
    echo "Error: no gateway service in {{NAMESPACE}}" >&2
    exit 1
  fi
  export BASE_URL="http://${GATEWAY_SVC}.{{NAMESPACE}}.svc.cluster.local"
  export NAMESPACE="{{NAMESPACE}}"
  PD_DIR="$(git rev-parse --show-toplevel)/guides/pd-disaggregation"
  mkdir -p "$PD_DIR/.tmp"
  command -v envsubst >/dev/null || { echo "Install gettext (envsubst), e.g. brew install gettext" >&2; exit 1; }
  envsubst '${BASE_URL} ${NAMESPACE}' < "$(git rev-parse --show-toplevel)/poker/Justfile.remote" > "$PD_DIR/.tmp/Justfile.remote.tmp"
  kubectl cp "$PD_DIR/.tmp/Justfile.remote.tmp" "{{NAMESPACE}}/poker:/workspace/Justfile"
  echo "Synced poker/Justfile.remote -> {{NAMESPACE}}/poker:/workspace/Justfile (BASE_URL=$BASE_URL)"

gateway-check:
  #!/usr/bin/env bash
  set -euo pipefail
  GATEWAY_SVC=$(kubectl -n "{{NAMESPACE}}" get svc -l gateway.networking.k8s.io/gateway-name -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
  if [ -z "$GATEWAY_SVC" ]; then
    echo "Error: no gateway service in {{NAMESPACE}}" >&2
    exit 1
  fi
  export BASE_URL="http://${GATEWAY_SVC}.{{NAMESPACE}}.svc.cluster.local"
  echo "Probing from pod poker: GET ${BASE_URL}/v1/models"
  {{KN}} exec poker -- env BASE_URL="$BASE_URL" bash -ce '
    set -euo pipefail
    code=$(curl -sS -o /tmp/gw.body -w "%{http_code}" --max-time 15 "$BASE_URL/v1/models" || true)
    echo "HTTP ${code}"
    echo "--- body (first 500 bytes) ---"
    head -c 500 /tmp/gw.body 2>/dev/null || true
    echo ""
  '

benchmark MC NUM_REQUESTS INPUT_LEN OUTPUT_LEN:
  #!/usr/bin/env bash
  set -euo pipefail
  just _sync-poker-justfile
  GATEWAY_SVC=$(kubectl -n "{{NAMESPACE}}" get svc -l gateway.networking.k8s.io/gateway-name -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
  if [ -z "$GATEWAY_SVC" ]; then
    echo "Error: no gateway service in {{NAMESPACE}}" >&2
    exit 1
  fi
  {{KN}} exec poker -- env BENCHMARK_MODEL="${BENCHMARK_MODEL:-}" bash -ce "
    set -euo pipefail
    cd /workspace
    export PATH=\"/tmp:\${PATH}:\${HOME}/.local/bin:/root/.local/bin\"
    if ! command -v just >/dev/null 2>&1; then
      if [ ! -x /tmp/just ]; then
        JUST_VERSION=1.40.0
        arch=\$(uname -m)
        case \"\$arch\" in
          x86_64) ju=\"x86_64-unknown-linux-musl\" ;;
          aarch64) ju=\"aarch64-unknown-linux-musl\" ;;
          *) echo \"poker pod: unsupported uname -m=\$arch for just bootstrap\" >&2; exit 1 ;;
        esac
        url=\"https://github.com/casey/just/releases/download/\${JUST_VERSION}/just-\${JUST_VERSION}-\${ju}.tar.gz\"
        curl -fsSL \"\$url\" | tar xz -C /tmp
        chmod +x /tmp/just
      fi
    fi
    just benchmark {{MC}} {{NUM_REQUESTS}} {{INPUT_LEN}} {{OUTPUT_LEN}}
  "

benchmark-just CMD:
  #!/usr/bin/env bash
  set -euo pipefail
  just _sync-poker-justfile
  {{KN}} exec poker -- bash -ce "
    export PATH=\"\${PATH}:\${HOME}/.local/bin:/root/.local/bin\"
    cd /workspace
    command -v just >/dev/null 2>&1 || { echo 'poker image has no just; use: just benchmark …' >&2; exit 127; }
    just {{CMD}}
  "

poke:
  #!/usr/bin/env bash
  set -euo pipefail
  just _sync-poker-justfile
  echo "Gateway: just benchmark MC NUM_REQUESTS INPUT_LEN OUTPUT_LEN (from laptop). In pod: just benchmark … or just benchmark_no_pd <decode-ip> …"
  echo "If /v1/models is 404: just apply-httproute or BENCHMARK_MODEL=… just benchmark …"
  {{KN}} exec -it poker -- bash -lc "cd /workspace && exec bash"

stop-poker:
  #!/usr/bin/env bash
  set -euo pipefail
  kubectl delete -f "$(git rev-parse --show-toplevel)/poker/poker.yaml" -n "{{NAMESPACE}}" --ignore-not-found=true
