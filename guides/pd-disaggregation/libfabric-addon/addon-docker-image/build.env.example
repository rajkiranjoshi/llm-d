# Build configuration for libfabric-addon image.
# Copy this file to build.env and edit to match your environment.
#
#   cp build.env.example build.env
#   # edit build.env
#   ./build.sh
#
# build.env is gitignored.

# --------------------------------------------------------------------------
# RHAIIS base image (used as the builder base for ABI-compatible compilation)
# --------------------------------------------------------------------------
BASE_IMAGE=registry.stage.redhat.io/rhaii/vllm-cuda-rhel9:3.5.0-1784900545

# --------------------------------------------------------------------------
# RHEL subscription certs (required for dnf install in builder stages)
# See rhel-subscription-setup.md for how to obtain these.
# --------------------------------------------------------------------------
ENTITLEMENT_DIR=./entitlement
RHSM_CA_DIR=./rhsm-ca

# --------------------------------------------------------------------------
# Output image tag
# --------------------------------------------------------------------------
ADDON_IMAGE_TAG=libfabric-addon:3.5.0-1784900545

# --------------------------------------------------------------------------
# Optional: push target (set to push after build)
# --------------------------------------------------------------------------
# ADDON_PUSH_TARGET=quay.io/rajjoshi/libfabric-addon:3.5.0-1784900545

# --------------------------------------------------------------------------
# Component versions (pinned to match the RHAIIS image + llm-d EFA build)
# Override only if you know what you're doing.
# --------------------------------------------------------------------------
# NIXL_VERSION=v1.2.0
# AWS_LIBFABRIC_VERSION=v2.3.1amzn4.0
