# Wide EP benchmarking on AKS ND H100 (2 nodes, 16 GPUs).
# Run from this directory: cd guides/wide-ep-lws/manifests/modelserver/aks-ndH100
set dotenv-load

NAMESPACE := env("NAMESPACE", env("USER", "dev") + "-dev")
KN := "kubectl -n " + NAMESPACE
LWS_PREFILL := "wide-ep-llm-d-prefill"
LWS_DECODE := "wide-ep-llm-d-decode"
INFPOOL_RELEASE := "llm-d-infpool"
INFPOOL_CHART := "oci://registry.k8s.io/gateway-api-inference-extension/charts/inferencepool"
INFPOOL_VERSION := "v1.4.0"

default:
  @just --list

# --- Deploy ---

deploy MODE:
  #!/usr/bin/env bash
  set -euo pipefail
  case "{{MODE}}" in
    prefill-only) {{KN}} apply -f prefill-only.yaml ;;
    decode-only)  {{KN}} apply -f decode-only.yaml ;;
    *)            echo "Usage: just deploy prefill-only|decode-only" >&2; exit 1 ;;
  esac
  echo "Deployed LWS {{MODE}} in {{NAMESPACE}}"

  echo "Installing InferencePool (helm)..."
  helm upgrade --install {{INFPOOL_RELEASE}} \
    {{INFPOOL_CHART}} \
    --version {{INFPOOL_VERSION}} \
    -n {{NAMESPACE}} \
    -f inferencepool-values.yaml \
    --set "provider.name=none"

  echo "Applying Gateway + HTTPRoute..."
  {{KN}} apply -f gateway.yaml -f httproute.yaml

  echo "Deploy complete. Run 'just status' to check readiness."

destroy:
  #!/usr/bin/env bash
  set -euo pipefail
  {{KN}} delete lws {{LWS_PREFILL}} --ignore-not-found=true &
  {{KN}} delete lws {{LWS_DECODE}} --ignore-not-found=true &
  wait

  {{KN}} delete -f httproute.yaml --ignore-not-found=true
  {{KN}} delete -f gateway.yaml --ignore-not-found=true
  helm uninstall {{INFPOOL_RELEASE}} -n {{NAMESPACE}} --ignore-not-found 2>/dev/null || true

  echo "Destroyed wide-ep LWS + gateway resources in {{NAMESPACE}}"

status:
  {{KN}} get pods -l llm-d.ai/guide=wide-ep-lws -o wide
  @echo ""
  {{KN}} get lws 2>/dev/null || true
  @echo ""
  @echo "--- Gateway ---"
  {{KN}} get gateway,httproute 2>/dev/null || true
  @echo ""
  @echo "--- InferencePool ---"
  {{KN}} get inferencepool 2>/dev/null || true
  @echo ""
  helm list -n {{NAMESPACE}} --filter '{{INFPOOL_RELEASE}}' 2>/dev/null || true

logs ROLE='prefill':
  {{KN}} logs -l llm-d.ai/role={{ROLE}},llm-d.ai/guide=wide-ep-lws -c vllm --tail=100 -f --max-log-requests=20

# Wait for all LWS pods of a given role to be ready (up to 45 min for large model startup).
ready ROLE:
  #!/usr/bin/env bash
  set -euo pipefail
  echo "Waiting for {{ROLE}} pods to be ready (up to 45 min)..."
  waited=0
  while true; do
    n=$({{KN}} get pods -l "llm-d.ai/role={{ROLE}},llm-d.ai/guide=wide-ep-lws" --no-headers 2>/dev/null | wc -l | tr -d ' ')
    if [[ "${n:-0}" -ge 1 ]]; then break; fi
    if [[ "$waited" -ge 600 ]]; then
      echo "timeout: no {{ROLE}} pods appeared within 600s" >&2; exit 1
    fi
    sleep 5; waited=$((waited + 5))
  done
  {{KN}} wait --for=condition=Ready pod \
    -l "llm-d.ai/role={{ROLE}},llm-d.ai/guide=wide-ep-lws" \
    --timeout=2700s
  echo "All {{ROLE}} pods ready."

# --- Poker + Benchmark ---

start-poker:
  kubectl apply -f "$(git rev-parse --show-toplevel)/poker/poker.yaml" -n "{{NAMESPACE}}"

stop-poker:
  kubectl delete -f "$(git rev-parse --show-toplevel)/poker/poker.yaml" -n "{{NAMESPACE}}" --ignore-not-found=true

# Discover the agentgateway service in the namespace and sync Justfile.remote into the poker pod.
_sync-poker-justfile:
  #!/usr/bin/env bash
  set -euo pipefail
  GATEWAY_SVC=$(kubectl -n "{{NAMESPACE}}" get svc -l gateway.networking.k8s.io/gateway-name -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
  if [[ -z "$GATEWAY_SVC" ]]; then
    echo "Error: no gateway service found in {{NAMESPACE}}. Did you run 'just deploy ...'?" >&2
    exit 1
  fi
  export BASE_URL="http://${GATEWAY_SVC}.{{NAMESPACE}}.svc.cluster.local"
  export NAMESPACE="{{NAMESPACE}}"
  REPO_ROOT="$(git rev-parse --show-toplevel)"
  TMPDIR_LOCAL=$(mktemp -d)
  trap 'rm -rf "$TMPDIR_LOCAL"' EXIT
  command -v envsubst >/dev/null || { echo "Install gettext (envsubst), e.g. brew install gettext" >&2; exit 1; }
  envsubst '${BASE_URL} ${NAMESPACE}' < "${REPO_ROOT}/poker/Justfile.remote" > "${TMPDIR_LOCAL}/Justfile"
  kubectl cp "${TMPDIR_LOCAL}/Justfile" "{{NAMESPACE}}/poker:/workspace/Justfile"
  echo "Synced poker Justfile (BASE_URL=$BASE_URL)"

# Probe the gateway from the poker pod.
gateway-check:
  #!/usr/bin/env bash
  set -euo pipefail
  GATEWAY_SVC=$(kubectl -n "{{NAMESPACE}}" get svc -l gateway.networking.k8s.io/gateway-name -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
  if [[ -z "$GATEWAY_SVC" ]]; then
    echo "Error: no gateway service found in {{NAMESPACE}}" >&2
    exit 1
  fi
  BASE_URL="http://${GATEWAY_SVC}.{{NAMESPACE}}.svc.cluster.local"
  echo "Probing from poker pod: GET ${BASE_URL}/v1/models"
  {{KN}} exec poker -- env BASE_URL="$BASE_URL" bash -ce '
    set -euo pipefail
    code=$(curl -sS -o /tmp/gw.body -w "%{http_code}" --max-time 15 "$BASE_URL/v1/models" || true)
    echo "HTTP ${code}"
    echo "--- body (first 500 bytes) ---"
    head -c 500 /tmp/gw.body 2>/dev/null || true
    echo ""
  '

# Benchmark via the gateway (requests go through agentgateway -> EPP -> vLLM pods).
# Usage: just benchmark 64 500 24000 1   (prefill-focused: high ISL, low OSL)
#        just benchmark 64 500 1 24000    (decode-focused: low ISL, high OSL)
benchmark MC NUM_REQUESTS INPUT_LEN OUTPUT_LEN:
  #!/usr/bin/env bash
  set -euo pipefail
  just _sync-poker-justfile
  {{KN}} exec poker -- bash -ce "
    set -euo pipefail
    cd /workspace
    export PATH=\"/tmp:\${PATH}:\${HOME}/.local/bin:/root/.local/bin\"
    if ! command -v just >/dev/null 2>&1; then
      if [ ! -x /tmp/just ]; then
        JUST_VERSION=1.40.0
        arch=\$(uname -m)
        case \"\$arch\" in
          x86_64)  ju=\"x86_64-unknown-linux-musl\" ;;
          aarch64) ju=\"aarch64-unknown-linux-musl\" ;;
          *)       echo \"unsupported arch: \$arch\" >&2; exit 1 ;;
        esac
        curl -fsSL \"https://github.com/casey/just/releases/download/\${JUST_VERSION}/just-\${JUST_VERSION}-\${ju}.tar.gz\" | tar xz -C /tmp
        chmod +x /tmp/just
      fi
    fi
    just benchmark {{MC}} {{NUM_REQUESTS}} {{INPUT_LEN}} {{OUTPUT_LEN}}
  "

# Resolve the leader pod IP for the currently deployed LWS (for direct benchmarking).
_leader-ip:
  #!/usr/bin/env bash
  set -euo pipefail
  for lws in {{LWS_PREFILL}} {{LWS_DECODE}}; do
    IP=$({{KN}} get pod "${lws}-0" -o jsonpath='{.status.podIP}' 2>/dev/null || true)
    if [[ -n "$IP" ]]; then
      echo "$IP"
      exit 0
    fi
  done
  echo "Error: no wide-ep leader pod found ({{LWS_PREFILL}}-0 or {{LWS_DECODE}}-0)" >&2
  exit 1

# Benchmark hitting the LWS leader pod directly (bypasses gateway).
benchmark-direct MC NUM_REQUESTS INPUT_LEN OUTPUT_LEN:
  #!/usr/bin/env bash
  set -euo pipefail
  LEADER_IP=$(just _leader-ip)
  BASE_URL="http://${LEADER_IP}:8000"
  MODEL=$({{KN}} exec poker -- curl -sf "${BASE_URL}/v1/models" | jq -r '.data[0].id')
  if [[ -z "$MODEL" || "$MODEL" == "null" ]]; then
    echo "Error: could not detect model from ${BASE_URL}/v1/models" >&2
    exit 1
  fi
  echo "Benchmarking DIRECT model=$MODEL at $BASE_URL (MC={{MC}}, N={{NUM_REQUESTS}}, ISL={{INPUT_LEN}}, OSL={{OUTPUT_LEN}})"
  {{KN}} exec poker -- bash -ce "
    set -euo pipefail
    export PATH=\"/tmp:\${PATH}:\${HOME}/.local/bin:/root/.local/bin\"
    if ! command -v just >/dev/null 2>&1; then
      if [ ! -x /tmp/just ]; then
        JUST_VERSION=1.40.0
        arch=\$(uname -m)
        case \"\$arch\" in
          x86_64)  ju=\"x86_64-unknown-linux-musl\" ;;
          aarch64) ju=\"aarch64-unknown-linux-musl\" ;;
          *)       echo \"unsupported arch: \$arch\" >&2; exit 1 ;;
        esac
        curl -fsSL \"https://github.com/casey/just/releases/download/\${JUST_VERSION}/just-\${JUST_VERSION}-\${ju}.tar.gz\" | tar xz -C /tmp
        chmod +x /tmp/just
      fi
    fi
    vllm bench serve \
      --base-url ${BASE_URL} \
      --model '${MODEL}' \
      --dataset-name random \
      --random-input-len {{INPUT_LEN}} \
      --random-output-len {{OUTPUT_LEN}} \
      --max-concurrency {{MC}} \
      --request-rate 4096 \
      --seed \$(date +%M%H%M%S) \
      --num-prompts {{NUM_REQUESTS}} \
      --ignore-eos
  "

poke:
  #!/usr/bin/env bash
  set -euo pipefail
  just _sync-poker-justfile 2>/dev/null || true
  LEADER_IP=$(just _leader-ip 2>/dev/null || echo "unknown")
  echo "Leader pod IP: ${LEADER_IP}"
  echo "Gateway benchmark: just benchmark MC N ISL OSL"
  echo "Direct benchmark:  just benchmark-direct MC N ISL OSL"
  echo "In pod: just benchmark ... (gateway) or just benchmark_no_pd <pod-ip> ..."
  {{KN}} exec -it poker -- bash -lc "cd /workspace && exec bash"
